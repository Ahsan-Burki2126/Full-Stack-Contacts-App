<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>500 - Internal Server Error</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f8f9fa;
        }

        .error-icon {
            font-size: 6rem;
            color: #dc3545;
        }
    </style>
</head>

<body>
    <div class="d-flex flex-column justify-content-center align-items-center min-vh-100 text-center px-3">
        <div class="error-icon mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h1 class="display-1 fw-bold text-danger">500</h1>
        <h2 class="fw-semibold mb-3">Internal Server Error</h2>
        <p class="mb-3 text-muted">
            Oops! Something went wrong on our side. Please try again later.
        </p>

        <% if (typeof message !=='undefined' ) { %>
            <p class="text-danger small">
                <%= message %>
            </p>
            <% } %>

                <a href="/" class="btn btn-danger px-4 mt-4">Go Home</a>
    </div>

    <!-- Bootstrap Icons CDN (Optional) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
</body>

</html>